# TAPKARD Backend Environment Configuration
# กรุณาคัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าที่ต้องการใช้งาน

# 1. แจ้งเตือนออเดอร์ใหม่เข้า LINE เจ้าของร้าน (LINE Notify หรือ LINE Bot Token)
LINE_NOTIFY_TOKEN=

# 2. ปลายทางส่งไฟล์งานให้โรงพิมพ์/ร้านสกรีน (Webhook หรือ อีเมล)
PRINT_SHOP_WEBHOOK=
PRINT_SHOP_EMAIL=

# 3. รหัสผ่านสำหรับเข้าหน้าแอดมิน Dashboard (ถ้ามี)
ADMIN_PASSWORD=tapkard2026

# 4. พอร์ตสำหรับเซิร์ฟเวอร์หลังบ้าน
PORT=8000
